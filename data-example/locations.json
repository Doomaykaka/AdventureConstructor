        {
          "text": "Налево - к дымку костра",
          "result": "exp+=5",
          "next": "nextNPC"
        },
        {
          "text": "Прямо - к тёмной пещере",
          "result": "exp+=5",
          "next": "nextFight"
        },
        {
          "text": "Направо - к старым руинам",
          "result": "exp+=5",
          "next": "nextSearch"
