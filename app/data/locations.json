{
  "locations": [
    {
      "id": "test_battle",
      "type": "hostile",
      "name": "Тестовый бой",
      "description": "Победи слабого врага: on_victory переведёт в test_search.",
      "auto_transition": false,
      "on_start": "log(\"Проверка on_start: боевая локация\")",
      "enemy_name": "Слабый тестовый противник",
      "enemy_hp": 50,
      "enemy_damage": 1,
      "enemy_defense": 0,
      "scale_enemy": false,
      "on_victory": "nextLocation(\"test_search\")",
      "on_defeat": "",
      "on_enemy_flee": "log(\"Enemy flee handler ran\"); nextLocation(\"test_search\")",
      "on_player_flee": "log(\"Player flee handler ran\"); nextLocation(\"test_npc\")"
    },
    {
      "id": "test_defeat",
      "type": "hostile",
      "name": "Проверка поражения",
      "description": "Противник наносит большой урон. on_defeat должен выполниться и перевести в test_search.",
      "auto_transition": false,
      "on_start": "log(\"Проверка on_start: боевая локация поражения\")",
      "enemy_name": "Сильный тестовый противник",
      "enemy_hp": 100,
      "enemy_damage": 1000,
      "enemy_defense": 0,
      "scale_enemy": false,
      "on_victory": "nextLocation(\"test_search\")",
      "on_defeat": "log(\"Поражение; вопрос? равенство =\"); heal50; nextLocation(\"test_search\")"
    },
    {
      "id": "test_npc",
      "type": "peaceful",
      "name": "Тестовая мирная локация",
      "description": "Мирная локация после боя.",
      "auto_transition": false,
      "on_start": "log(\"Проверка on_start: мирная локация\")",
      "npc_name": "Тестовый NPC",
      "dialog_id": "test_dialog",
      "on_success": "nextLocation(\"test_search\")",
      "on_fail": "nextLocation(\"test_defeat\")"
    },
    {
      "id": "test_search",
      "type": "exploratory",
      "name": "Заброшенный лагерь",
      "description": "Среди развалин лагеря видны следы недавней стоянки и закрытый дорожный сундук.",
      "auto_transition": false,
      "on_start": "log(\"Проверка on_start: исследовательская локация\")",
      "actions": [
        {
          "text": "Проверить AND: оба условия истинны",
          "result": "1==1 and 2==2 ? log(\"AND: условие выполнено\") : log(\"AND: ошибка\")"
        },
        {
          "text": "Проверить AND: одно условие ложно",
          "result": "1==1 and 2==3 ? log(\"AND: ошибка\") : log(\"AND: ложное условие распознано\")"
        },
        {
          "text": "Проверить OR: одно условие истинно",
          "result": "1==2 or 2==2 ? log(\"OR: условие выполнено\") : log(\"OR: ошибка\")"
        },
        {
          "text": "Проверить OR: оба условия ложны",
          "result": "1==2 or 2==3 ? log(\"OR: ошибка\") : log(\"OR: ложные условия распознаны\")"
        },
        {
          "text": "Проверить NOT: инверсия ложного условия",
          "result": "not 1==2 ? log(\"NOT: условие выполнено\") : log(\"NOT: ошибка\")"
        },
        {
          "text": "Проверить NOT: инверсия истинного условия",
          "result": "not 1==1 ? log(\"NOT: ошибка\") : log(\"NOT: истинное условие инвертировано\")"
        },
        {
          "text": "Проверить скобки и приоритет операторов",
          "result": "(1==2 or 2==2) and not 3==4 ? log(\"Составное условие выполнено\") : log(\"Ошибка группировки или приоритета\")"
        },
        {
          "text": "Проверить знаки внутри информационного диалога",
          "result": "showMessage(\"Вопрос? Равенство =; точка с запятой внутри строки.\")"
        },
        {
          "text": "Проверить знаки внутри тернарного выражения",
          "result": "1==1 ? showMessage(\"Условие верно: да?\") : showMessage(\"Условие неверно: нет?\")"
        },
        {
          "text": "Создать оружие с заданным именем",
          "result": "itemWeapon(\"Меч проверки\"); log(\"Создано оружие «Меч проверки»\")"
        },
        {
          "text": "Создать броню с заданным именем",
          "result": "itemArmor(\"Кираса проверки\"); log(\"Создана броня «Кираса проверки»\")"
        },
        {
          "text": "Создать расходник с заданным именем",
          "result": "itemConsumable(\"Зелье проверки\"); log(\"Создан расходник «Зелье проверки»\")"
        },
        {
          "text": "Проверить наличие меча в инвентаре",
          "result": "hasItem(\"Меч проверки\")==1 ? log(\"Меч проверки найден в инвентаре\") : log(\"Меч проверки отсутствует\")"
        },
        {
          "text": "Проверить удаление предмета по имени",
          "result": "removeItem(\"Меч проверки\"); hasItem(\"Меч проверки\")==0 ? log(\"Предмет удалён\") : log(\"Ошибка: предмет остался\")"
        },
        {
          "text": "Проверить death",
          "result": "death"
        }
      ]
    }
  ]
}
