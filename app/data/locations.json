{
  "locations": [
    {
      "id": "test_battle",
      "type": "hostile",
      "name": "Тестовый бой",
      "description": "Проверка перехода nextRandom после победы.",
      "auto_transition": false,
      "enemy_name": "Слабый тестовый противник",
      "enemy_hp": 4,
      "enemy_damage": 1,
      "enemy_defense": 0,
      "scale_enemy": false,
      "on_victory": "nextRandom",
      "on_defeat": ""
    },
    {
      "id": "test_npc",
      "type": "peaceful",
      "name": "Тестовая мирная локация",
      "description": "Мирная локация после боя.",
      "auto_transition": false,
      "npc_name": "Тестовый NPC",
      "dialog_id": "test_dialog",
      "on_success": "nextRandom",
      "on_fail": "nextLocation(\"test_battle\")"
    },
    {
      "id": "test_search",
      "type": "exploratory",
      "name": "Заброшенный лагерь",
      "description": "Среди развалин лагеря видны следы недавней стоянки и закрытый дорожный сундук.",
      "auto_transition": false,
      "actions": [
        {
          "text": "Подобрать предмет для проверки инвентаря",
          "result": "item"
        },
        {
          "text": "Вывести размер инвентаря в лог",
          "result": "log(\"Размер инвентаря: {inventorySize}\")"
        },
        {
          "text": "Получить тестовое оружие",
          "result": "itemWeapon"
        },
        {
          "text": "Проверить экипированное оружие",
          "result": "hasWeapon==1 ? log(\"Оружие экипировано\") : log(\"Оружие не экипировано\")"
        },
        {
          "text": "Получить тестовую броню",
          "result": "itemArmor"
        },
        {
          "text": "Проверить экипированную броню",
          "result": "hasArmor==1 ? log(\"Броня экипирована\") : log(\"Броня не экипирована\")"
        },
        {
          "text": "Установить пользовательскую переменную в 42",
          "result": "setVar(\"testValue\", 42)"
        },
        {
          "text": "Увеличить пользовательскую переменную на 1",
          "result": "setVar(\"testValue\", getVar(\"testValue\")+1)"
        },
        {
          "text": "Проверить пользовательскую переменную",
          "result": "getVar(\"testValue\")==43 ? log(\"Переменная прочитана: 43\") : log(\"Переменная не равна 43\")"
        },
        {
          "text": "Установить тестовую строку",
          "result": "setVar(\"testGreeting\", \"Привет, герой!\")"
        },
        {
          "text": "Вывести тестовую строку в лог",
          "result": "log(getVar(\"testGreeting\"))"
        },
        {
          "text": "Перейти в мирную локацию по ID",
          "result": "nextLocation(\"test_npc\")"
        },
        {
          "text": "Перейти в боевую локацию по ID",
          "result": "nextLocation(\"test_battle\")"
        },
        {
          "text": "Перейти в эту локацию по ID",
          "result": "nextLocation(\"test_search\")"
        },
        {
          "text": "Перейти в случайную локацию любого типа",
          "result": "nextRandom"
        },
        {
          "text": "Осмотреть дорожный сундук",
          "result": "gold+=5"
        },
        {
          "text": "Вернуться к торговцу",
          "result": "nextLocation(\"test_npc\")"
        },
        {
          "text": "Пойти по следам в чащу",
          "result": ""
        }
      ]
    }
  ]
}
